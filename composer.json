{
    "name": "kreatiflabs/laravel-bank-guard",
    "description": "Indonesian Bank Master Data, Account Number Sanitizer & Precision Validation Guard for Laravel",
    "keywords": [
        "laravel",
        "bank",
        "indonesia",
        "bank-indonesia",
        "validation",
        "rekening",
        "bca",
        "mandiri",
        "bri",
        "bni",
        "bi-fast",
        "kreatiflabs",
        "bank-guard"
    ],
    "homepage": "https://github.com/kreatiflabs/laravel-bank-guard",
    "license": "MIT",
    "authors": [
        {
            "name": "Kreatiflabs",
            "email": "dev@kreatiflabs.id",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.2|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kreatiflabs\\BankGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kreatiflabs\\BankGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kreatiflabs\\BankGuard\\BankGuardServiceProvider"
            ],
            "aliases": {
                "BankGuard": "Kreatiflabs\\BankGuard\\Facades\\BankGuard"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
